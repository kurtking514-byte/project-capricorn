<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets Capri set alarms and timers in the system clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- 3.3: "Uninstall" from Capri's grab menu opens Android's own uninstall dialog -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 3.9e: weather in the status scan (Open-Meteo, rough location only, asked via chat "weather") -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 3.13: "call mom" finds the contact (opens the dialer; Capri never calls by herself) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 4.5: the "let Capri run in the background" pop-up on the setup screen -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 3.10: face down = full silent (user allows "Do Not Disturb access" via chat "quiet") -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 3.9e: screen time today (user turns on "Usage access" via chat "usage") -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Needed on Android 11+ to see the list of installed apps for the drawer. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 5.1: other launchers, so suggestions never count "going home" as using an app -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Capri">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mini Capri floating over other apps, with quick controls. The user switches it on in Accessibility settings. -->
        <service
            android:name=".overlay.CapriOverlayService"
            android:exported="true"
            android:label="@string/overlay_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/capri_overlay" />
        </service>

        <!-- C5: lets Capri react when a notification arrives (only the app name is used). Switched on in Notification access settings. -->
        <service
            android:name=".overlay.CapriNotifListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
